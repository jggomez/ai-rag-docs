{"spans": [{"trace_id": "GoWauCRjlMk+nNZdPC0W3A==", "span_id": "yrT+HPSpH9U=", "parent_span_id": null, "name": "Models.embed_content", "start_time_unix_nano": 1780690016711437000, "end_time_unix_nano": 1780690021342693000, "events": [], "status": {"code": "STATUS_CODE_OK", "message": ""}, "attributes": {"mlflow.traceRequestId": "\"tr-1a859ab8246394c93e9cd65d3c2d16dc\"", "mlflow.spanType": "\"EMBEDDING\"", "mlflow.spanInputs": "{\"model\": \"gemini-embedding-2\", \"contents\": \"Proyecto Hidroeléctrico Ituango. Contrato No. CT-2011-000009. Asesoría durante Construcción. Contrato No. CW 276532. Construcción de obras civiles finales para la puesta en operación de las Unidades de Generación 5 a 8 del Proyecto Hidroeléctrico Ituango. Temática: Caverna de transformadores Instrumentación Geotécnica. Plano de construcción Galería Intermedia Pozo de evacuación de Humos cota 340.\\nEstimado Ingeniero Di Ubaldo,\\n\\nCon la presente comunicación la Asesoría remite el plano para construcción con la localización, tipo y detalles de la instrumentación geotécnica proyectada para el monitoreo de la Galería intermedia de Humos sobre la cota 340. Se hace entrega formal de una copia impresa y un CD que contiene los archivos en formato PDF y DWG correspondientes al siguiente plano para construcción:\\n\\nEs importante señalar que este plano es una versión 0, y si bien los instrumentos están contemplados dentro del ítem \\\"Argollas para el control de convergencia en excavaciones subterráneas\\\", no se cuenta con un código específico para este frente de obra, ya que este no fue inicialmente considerado por lo que representan cantidades adicionales. No obstante, estos instrumentos, que consisten en tres estaciones de convergencia con tres cuerdas cada una, se consideran esenciales para abordar las necesidades actuales de monitoreo geotécnico en este sector.\\n\\nCordialmente,\", \"config\": {\"http_options\": null, \"task_type\": \"RETRIEVAL_DOCUMENT\", \"title\": null, \"output_dimensionality\": 768, \"mime_type\": null, \"auto_truncate\": null, \"document_ocr\": null, \"audio_track_extraction\": null}}", "mlflow.message.format": "\"gemini\"", "mlflow.llm.model": "\"gemini-embedding-2\"", "mlflow.llm.provider": "\"gemini\"", "mlflow.spanOutputs": "{\"sdk_http_response\": {\"headers\": {\"content-type\": \"application/json; charset=UTF-8\", \"vary\": \"Origin, X-Origin, Referer\", \"content-encoding\": \"gzip\", \"date\": \"Fri, 05 Jun 2026 20:07:01 GMT\", \"server\": \"scaffolding on HTTPServer2\", \"x-xss-protection\": \"0\", \"x-frame-options\": \"SAMEORIGIN\", \"x-content-type-options\": \"nosniff\", \"server-timing\": \"gfet4t7; dur=4540\", \"alt-svc\": \"h3=\\\":443\\\"; ma=2592000,h3-29=\\\":443\\\"; ma=2592000\", \"transfer-encoding\": \"chunked\"}, \"body\": null}, \"embeddings\": [{\"values\": [-0.028071295, -0.0077304034, 0.0067466935, -0.038658388, 0.0075838035, -0.04444836, -0.027571587, -0.038545605, 0.0033069716, -0.061899554, -0.048369132, -0.009957652, 0.0010244905, 0.03265882, 0.008889853, -0.03416012, 0.04025572, 0.022701599, 0.023702528, 0.021168608, 0.0100973, -0.037736125, 0.036805447, -0.0017875797, -0.020495385, 0.037295464, 0.04003715, -0.015498686, 0.014073853, 0.20544685, 0.018541181, -0.01862232, -0.042961076, -0.03374673, 0.031581625, -0.053617254, -0.017035099, -0.011658552, -0.0059565413, -0.014475868, 0.0079728365, 0.041216314, -0.011227686, 0.011340745, 0.0043726778, -0.032531217, -0.033404335, 0.027029723, 0.004517908, 0.002053885, -0.057858247, -0.025641145, -0.025293741, -0.017578382, -0.00518028, 0.009910558, -0.010287534, -0.024660943, 0.037964318, 0.03482028, -0.025525695, 0.02824283, 0.030650454, 0.0044415947, -0.008316707, 0.0802868, 0.025515167, 0.0010378308, 0.0010946215, -0.023732584, 0.028634861, 0.013811204, 0.0006244033, -0.029923534, -0.008991897, -0.019838827, -0.034190435, 0.033845894, -0.031228762, 0.07873376, -0.0071798563, -0.036659595, -0.019563584, -0.051876616, 0.0053380295, 0.049291123, -0.0
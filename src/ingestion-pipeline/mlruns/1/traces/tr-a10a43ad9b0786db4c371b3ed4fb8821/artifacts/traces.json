{"spans": [{"trace_id": "oQpDrZsHhttMNxs+1PuIIQ==", "span_id": "EqzVIesc0rc=", "parent_span_id": null, "name": "Models.embed_content", "start_time_unix_nano": 1780689446586057000, "end_time_unix_nano": 1780689448747693000, "events": [], "status": {"code": "STATUS_CODE_OK", "message": ""}, "attributes": {"mlflow.traceRequestId": "\"tr-a10a43ad9b0786db4c371b3ed4fb8821\"", "mlflow.spanType": "\"EMBEDDING\"", "mlflow.spanInputs": "{\"model\": \"gemini-embedding-2\", \"contents\": \"​\\nSupervisión técnica – Almenaras y obras anexas - Pórtico de manejo de compuertas de \\naspiración – Embebidos – Planos de taller platinas tipo 4 y 5. – Su comunicación \\nCYS-CW276532-PHl-01111.\\n●​ En el isométrico se debe incluir alguna referencia (por ejemplo ejes) para aclarar a qué sector del pórtico corresponde lo mostrado.\\nSe indica que, la aprobación de estos planos con comentarios por parte de Interventoría, no exime al Contratista de la responsabilidad por la exactitud en la información que deben contener para atender lo indicado en los planos para construcción y los requerimientos para fabricación y montaje, por lo que se solicita al Contratista el envío del ajuste de las observaciones realizadas.\", \"config\": {\"http_options\": null, \"task_type\": \"RETRIEVAL_DOCUMENT\", \"title\": null, \"output_dimensionality\": 768, \"mime_type\": null, \"auto_truncate\": null, \"document_ocr\": null, \"audio_track_extraction\": null}}", "mlflow.message.format": "\"gemini\"", "mlflow.llm.model": "\"gemini-embedding-2\"", "mlflow.llm.provider": "\"gemini\"", "mlflow.spanOutputs": "{\"sdk_http_response\": {\"headers\": {\"content-type\": \"application/json; charset=UTF-8\", \"vary\": \"Origin, X-Origin, Referer\", \"content-encoding\": \"gzip\", \"date\": \"Fri, 05 Jun 2026 19:57:28 GMT\", \"server\": \"scaffolding on HTTPServer2\", \"x-xss-protection\": \"0\", \"x-frame-options\": \"SAMEORIGIN\", \"x-content-type-options\": \"nosniff\", \"server-timing\": \"gfet4t7; dur=2079\", \"alt-s
{"spans": [{"trace_id": "BxZZI3Lm4LAkxNcJvUPfPg==", "span_id": "B9x6DfClJE4=", "parent_span_id": null, "name": "Models.embed_content", "start_time_unix_nano": 1780686587415495000, "end_time_unix_nano": 1780686588795875000, "events": [], "status": {"code": "STATUS_CODE_OK", "message": ""}, "attributes": {"mlflow.traceRequestId": "\"tr-0716592372e6e0b024c4d709bd43df3e\"", "mlflow.spanType": "\"EMBEDDING\"", "mlflow.spanInputs": "{\"model\": \"gemini-embedding-2\", \"contents\": \"Proyecto Hidroeléctrico Ituango. Contrato No. CT-2011-000009. Asesoría durante Construcción. Contrato No. CW 276532. Construcción de obras civiles finales para la puesta en operación de las unidades de generación 5 a 8 del Proyecto Hidroeléctrico Ituango. Temática: Presa y obras anexas. Medidor de infiltraciones – Entrega planos para la excavación de la plataforma en la cota 235 m s.n.m., construcción de la pantalla plástica y los tratamientos para el cierre contra el estribo derecho.\\nEstimado Ingeniero Di Ubaldo,\\n\\nMediante la presente comunicación se hace entrega de los planos de excavación de la plataforma, detalles de construcción de la pantalla plástica y tratamientos para la zona donde se construirá el medidor de infiltraciones y su cierre hacia el estribo derecho. Se remite una (1) copia impresa y un (1) CD con los archivos correspondientes en formato .DWG y .PDF de los planos para construcción, tal como se indica en la Tabla 1.\\n\\nCordialmente,\\n\\nGABRIEL ANTONIO ROMERO PÉREZ\\nCoordinador General Asesoría (E)\\n\\nAnexo: El documento indicado en esta comunicación se encuentra cargado en Vault en la siguiente carpeta de almacenamiento: $/2_Tecnico Adtva/CW 276532 CONSORCIO CYS/02 Asesoría/01 Comunicaciones/2025/02 Campo/COP-0168. Nota: Una vez sean aprobados los archivos anexos, éstos serán reubicados según la estructura documental y podrán ser localizados con las herramientas de búsqueda del sistema.\", \"config\": {\"http_options\": null, \"task_type\": \"RETRIEVAL_DOCUMENT\", \"title\": null, \"output_dimensionality\": 768, \"mime_type\": null, \"auto_truncate\": null, \"document_ocr\": null, \"audio_track_extraction\": null}}", "mlflow.message.format": "\"gemini\"", "mlflow.llm.model": "\"gemini-embedding-2\"", "mlflow.llm.provider": "\"gemini\"", "mlflow.spanOutputs": "{\"sdk_http_response\": {\"headers\": {\"content-type\": \"application/json; charset=UTF-8\", \"vary\": \"Origin, X-Origin, Referer\", \"content-encoding\": \"gzip\", \"date\": \"Fri, 05 Jun 2026 19:09:49 GMT\", \"server\": \"scaffolding on HTTPServer2\", \"x-xss-protection\": \"0\", \"x-frame-options\": \"SAMEORIGIN\", \"x-content-type-options\": \"nosniff\", \"server-timing\": \"gfet4t7; dur=1287\", \"alt-svc\": \"h3=\\\":443\\\"; ma=2592000,h3-29=\\\":443\\\"; ma=2592000\", \"transfer-encoding\": \"chunked\"}, \"body\": null}, \"embeddings\": [{\"values\": [-0.0012937326, -0.013476103, 0.0055116285, -0.017320873, -0.0026295693, 0.0038268485, -0.023960045, -0.046742313, -0.014753992, -0.040350486, -0.030280309, -0.0376668, -0.02529435, 0.032494906, 0.01847564, -0.019654144, 0.017986365, 0.034384035, 0.01568192, 0.028259281, 0.017146759, -0.028858604, 0.02401675, -0.015918205, -0.034169067, 0.032738104, 0.020357776, -0.0051427474, -0.031388648, 0.21916987, 0.023376785, -0.01023472, -0.051038247, -0.023938242, -0.0009836479, -0.024762435, -0.023460124, -0.007302435, 0.022700286, -0.05910093, 0.012618461, 0.023480056, -0.041645408, 0.021677801, 0.0029098527, -0.04687959, -0.019715056, 0.00432434, 0.015777515, -0.02539571, -0.052618265, -0.001992607, -0.0150773255, 0.0074772523, -0.0077912584, 0.024510227, -0.011937552, 0.004642333, 0.022965567, 0.02038832, -0.03822459, 0.028880933, 0.03164366, 0.0130377095, 0.013453688, 0.08537553, 0.02240841, -0.00045401725, 0.0026099633, -0.024049098, -0.0019868026, 0.00083789416, 0.007498652, -0.018898224, -0.013646391, -0.019586172, -0.02317185, 0.00446056, -0.0217497, 0.0720474, -0.010076915, -0.038389254, -0.016758569, -0.023477
{"spans": [{"trace_id": "TXP9GwWtghtGl6paLI0l/w==", "span_id": "4x29lInNgZ4=", "parent_span_id": null, "name": "Models.embed_content", "start_time_unix_nano": 1780689560869221000, "end_time_unix_nano": 1780689561698668000, "events": [], "status": {"code": "STATUS_CODE_OK", "message": ""}, "attributes": {"mlflow.traceRequestId": "\"tr-4d73fd1b05ad821b4697aa5a2c8d25ff\"", "mlflow.spanType": "\"EMBEDDING\"", "mlflow.spanInputs": "{\"model\": \"gemini-embedding-2\", \"contents\": \"Proyecto Hidroeléctrico Ituango. Contrato No. CT-2011-000009. Asesoría durante Construcción. Contrato No. CW 276532. Construcción de obras civiles finales para la puesta en operación de las unidades de generación 5 a 8 del Proyecto Hidroeléctrico Ituango. Temática: Casa de Máquinas y obas anexas -Almenara y obras anexas Solicitud de tratamiento ejecutado en las paredes intervenidas de las cavernas de casa de máquinas sur y almenara No.2, ejecutas por CYS, de acuerdo a lo indicado en los planos para construcción.\\nEstimado Ingeniero Di Ubaldo,\\n\\nTeniendo en cuenta el avance en la rehabilitación de las cavernas de Casa de Máquinas Sur y Almenara No.2, la Asesoría solicita requerirle a la Interventoría compartir un esquema delimitando las zonas intervenidas en hastiales, culata y bóveda de dichas cavernas, considerando el proceso de saneamiento definido en los planos de construcción DC-PHI-060-GRL-SS-C-003 y DC-PHI-072-ALM-SS-C-005, especificando las siguientes condiciones:\\n\\n1. Restitución del soporte (Macizo rocoso expuesto).\\n2. Remoción total del concreto lanzado (Más de dos capas de concreto afectadas).\\n3. Remoción parcial del concreto lanzado (Dos o menos capas de concreto afectadas).\\n4. Pérdida de adherencia en el concreto lanzado y sin agrietamiento (Inyecciones de contacto).\\n5. Desgaste del concreto lanzado y sin agrietamiento (Capa adicional de concreto lanzado de 0,05 m de espesor).\", \"config\": {\"http_options\": null, \"task_type\": \"RETRIEVAL_DOCUMENT\", \"title\": null, \"output_dimensionality\": 768, \"mime_type\": null, \"auto_truncate\": null, \"document_ocr\": null, \"audio_track_extraction\": null}}", "mlflow.message.format": "\"gemini\"", "mlflow.llm.model": "\"gemini-embedding-2\"", "mlflow.llm.provider": "\"gemini\"", "mlflow.spanOutputs": "{\"sdk_http_response\": {\"headers\": {\"content-type\": \"application/json; charset=UTF-8\", \"vary\": \"Origin, X-Origin, Referer\", \"content-encoding\": \"gzip\", \"date\": \"Fri, 05 Jun 2026 19:59:21 GMT\", \"server\": \"scaffolding on HTTPServer2\", \"x-xss-protection\": \"0\", \"x-frame-options\": \"SAMEORIGIN\", \"x-content-type-options\": \"nosniff\", \"server-timing\": \"gfet4t7; dur=749\", \"alt-svc\": \"h3=\\\":443\\\"; ma=2592000,h3-29=\\\":443\\\"; ma=2592000\", \"transfer-encoding\": \"chunked\"}, \"body\": null}, \"embeddings\": [{\"values\": [-0.02255555, -0.027992724, 0.027312197, 0.0062413653, 0.02334144, -0.018300008, -0.026964536, -0.03610177, -0.04377481, -0.07072902, -0.030364605, -0.0091515435, 0.013155174, 0.012472082, 0.009188749, -0.020234987, 0.01255465, 0.009102007, 0.047260743, 0.013671791, -0.02039405, -0.018689351, 0.013344523, 0.003568234, -0.04994671, 0.04168398, 0.024281355, -0.013750821, -0.016932063, 0.21688728, 0.00048840686, 0.007969731, -0.058362547, -0.021618411, 0.0056745075, -0.04281193, -0.022543047, -0.017853402, 0.048492447, -0.015280887, -0.008393797, 0.06560734, 0.002542717, 0.010018372, -0.038467497, -0.057585947, -0.021911329, -0.017591018, -0.0054839402, -0.041544434, -0.032260086, -0.007149392, -0.038658988, -0.013091183, -0.007724638, 0.018783957, -0.022524621, 0.011391561, 0.026391473, 0.03577777, -0.029506397, 0.029976172, 0.024278713, -0.0023407491, -0.014771216, 0.082794316, 0.007886809, -0.00038776305, -0.026368313, -0.01324722, 0.00027271325, -0.0015784157, -0.009766431, -0.058955535, -0.050348073, 0.002709722, -0.026114754, -0.004735892, -0.013032221, 0.07474612, -0.013809675, -0.0005854579, 0.0044229683, -0.017136062, 0.
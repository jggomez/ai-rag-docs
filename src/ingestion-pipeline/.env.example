# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_COMMUNICATIONS_BUCKET=communications-cys
GCS_RECEIVED_PREFIX=COMMUNICATIONS_RECEIVED/
GCS_SENT_PREFIX=COMMUNICATIONS_SENT/

# Firestore Configuration
FIRESTORE_DATABASE=(default)

# AI Models
GEMINI_API_KEY=your-api-key
GEMINI_OCR_MODEL=gemini-3-flash-preview
EMBEDDING_MODEL=models/embedding-001

# Google Drive Configuration
DRIVE_SERVICE_ACCOUNT_PATH=path/to/service-account.json

# App Settings
LOG_LEVEL=INFO

# GCS Output for generated response PDFs
GCS_OUTPUT_BUCKET=communications-cys
GCS_OUTPUT_PREFIX=COMMUNICATIONS_SENT
